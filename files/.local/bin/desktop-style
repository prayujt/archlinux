#!/usr/bin/env python3
"""Switch between the saved original desktop and Nothing / Orbit."""
from pathlib import Path
import fcntl, json, os, shutil, signal, subprocess, sys, tempfile, time

home = Path.home()
state = home / '.local/state/desktop-styles'
original = state / 'original'
style = home / '.local/share/desktop-styles/nothing-orbit'
original_source = original if (original / 'config').is_dir() else style.parent / 'original'
files = ['alacritty/alacritty.toml', 'hypr/hyprpaper.conf', 'hypr/hyprland.lua', 'quickshell/GlyphSidebar.qml', 'quickshell/DesktopPalette.qml', 'quickshell/SidebarSlider.qml', 'quickshell/EarthGlobe.qml', 'quickshell/OrbitalDesktop.qml', 'quickshell/shell.qml']
topbar_source = state / 'before-sidebar'
metadata = json.loads((original / 'state.json').read_text()) if (original / 'state.json').exists() else {}
unit = 'nature-wallpaper-preview.service'

def run(args, **kwargs):
    return subprocess.run(args, text=True, capture_output=True, **kwargs)

def install(source):
    # Stop before changing files so automatic reload cannot mix two profiles.
    shell_path = str(home / '.config/quickshell/shell.qml')
    result = run(['quickshell', 'list', '-j', '-p', shell_path], timeout=3)
    instances = json.loads(result.stdout) if result.stdout.lstrip().startswith('[') else []
    for instance in instances:
        pid = instance['pid']
        try:
            os.kill(pid, signal.SIGTERM)
            for attempt in range(15):
                if not Path('/proc', str(pid)).exists():
                    break
                time.sleep(0.02)
            else:
                os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    for name in files:
        src = source / 'config' / name
        if not src.exists():
            continue
        dest = (home / '.config' / name).resolve()
        fd, tmp = tempfile.mkstemp(prefix='.desktop-style-', dir=dest.parent)
        os.close(fd)
        shutil.copy2(src, tmp)
        os.replace(tmp, dest)

def launch_shell():
    shell_path = str(home / '.config/quickshell/shell.qml')
    subprocess.Popen(['quickshell', '-n', '-p', shell_path],
                     env={**os.environ, 'QML_DISABLE_DISK_CACHE': '1'},
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)

def reload(profile):
    result = run(['hyprctl', 'reload', 'config-only'])
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    errors = run(['hyprctl', 'configerrors']).stdout.strip()
    if errors:
        raise RuntimeError(errors)
    # Start without inherited output pipes; IPC below verifies the fresh engine.
    launch_shell()
    # Wait until Quickshell has actually accepted the requested configuration.
    expected = 'nothing-orbit' if profile in ['nothing', 'topbar'] else profile
    for attempt in range(30):
        result = run(['quickshell', 'ipc', '-p', str(home / '.config/quickshell/shell.qml'), 'call', 'panels', 'status'], timeout=2)
        try:
            status = json.loads(result.stdout)
            actual = status.get('desktopStyle', 'original')
            variant_ready = (bool(status.get('sidebar')) and status.get('desktopReady', True)) if profile == 'nothing' else not status.get('sidebar', False)
            if actual == expected and variant_ready:
                return
        except (json.JSONDecodeError, AttributeError):
            pass
        time.sleep(0.2)
    raise RuntimeError('Quickshell did not finish loading ' + expected)

def wallpaper(profile):
    saved = json.loads((style.parent / 'meadow/state.json').read_text()) if profile == 'meadow' else metadata
    if not saved.get('wallpaper_active'):
        return
    run(['systemctl', '--user', 'stop', unit])
    command = ['systemd-run', '--user', '--collect', '--unit=nature-wallpaper-preview']
    for key in ['WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR']:
        if key in os.environ:
            command.append('--setenv=' + key + '=' + os.environ[key])
    result = run(command + saved['wallpaper_command'])
    if result.returncode:
        raise RuntimeError(result.stderr or result.stdout)
    time.sleep(0.3)
    if run(['systemctl', '--user', 'is-active', '--quiet', unit]).returncode:
        raise RuntimeError('Saved wallpaper player failed to start.')

if len(sys.argv) != 2 or sys.argv[1] not in ['nothing', 'meadow', 'toggle', 'topbar', 'original', 'startup', 'status']:
    sys.exit('Usage: desktop-style nothing | meadow | toggle | topbar | original | startup | status')
profile = sys.argv[1]
if profile == 'status':
    print((state / 'current').read_text().strip() if (state / 'current').exists() else 'original')
    sys.exit()

switch_lock = (state / 'switch.lock').open('a')
try:
    fcntl.flock(switch_lock, fcntl.LOCK_EX | (fcntl.LOCK_NB if profile == 'toggle' else 0))
except BlockingIOError:
    sys.exit()
previous = (state / 'current').read_text().strip() if (state / 'current').exists() else 'original'
if profile == 'startup':
    launch_shell()
    if previous in ['meadow', 'original']:
        wallpaper(previous)
    sys.exit()
if profile == 'toggle':
    profile = 'meadow' if previous == 'nothing' else 'nothing'

try:
    if profile == 'nothing':
        run(['systemctl', '--user', 'stop', unit])
        install(style)
        reload(profile)
    elif profile == 'topbar':
        run(['systemctl', '--user', 'stop', unit])
        install(topbar_source)
        reload(profile)
    elif profile == 'meadow':
        install(style.parent / 'meadow')
        reload(profile)
        wallpaper(profile)
    else:
        install(original_source)
        reload(profile)
        wallpaper(profile)
    (state / 'current').write_text(profile + '\n')
    print('Desktop style: ' + profile)
    if profile == 'nothing':
        print('Glassy mode: desktop-style meadow  (or Super+Alt+Backspace)')
    if profile in ['nothing', 'meadow']:
        print('Switch modes: Super+Ctrl+Alt+M')
except Exception as error:
    print('Style switch failed: ' + str(error), file=sys.stderr)
    if profile in ['nothing', 'meadow']:
        try:
            recovery_profile = previous if previous != profile else 'topbar'
            recovery_source = {'nothing': style, 'meadow': style.parent / 'meadow',
                               'original': original_source, 'topbar': topbar_source}[recovery_profile]
            install(recovery_source)
            reload(recovery_profile)
            if recovery_profile in ['meadow', 'original']:
                wallpaper(recovery_profile)
            (state / 'current').write_text(recovery_profile + '\n')
            print('Restored desktop style: ' + recovery_profile, file=sys.stderr)
        except Exception as recovery:
            print('Restore command: desktop-style original\n' + str(recovery), file=sys.stderr)
    sys.exit(1)
