#!/usr/bin/env python3
import sys
import os
import subprocess
import fcntl
import json

STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".brightness")
VCP_CODE = "10"
MONITORS = {"2": ("Samsung", "Odyssey G40B"), "1": ("HP", "HP 727pu")}
# The G40B acknowledges writes but reports zero at every tested brightness.
UNRELIABLE_READBACK = {"2"}

def load_state():
    state = {}
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r") as f:
            for line in f:
                try:
                    mon_id, val = line.strip().split(":")
                    state[mon_id] = int(val)
                except ValueError:
                    continue
    return state

def save_state(state):
    with open(STATE_FILE, "w") as f:
        for mon_id, val in state.items():
            f.write(f"{mon_id}:{val}\n")

def ddc(monitor_id, *args):
    # Select by model so reconnecting a monitor cannot swap the sliders.
    selection = ["--model", MONITORS[monitor_id][1]]
    return subprocess.run(["ddcutil", *selection, *args], check=True,
                          text=True, capture_output=True, timeout=10).stdout

def read_brightness(monitor_id):
    fields = ddc(monitor_id, "getvcp", VCP_CODE, "--terse").split()
    if len(fields) != 5 or fields[:3] != ["VCP", VCP_CODE, "C"]:
        raise ValueError("Monitor did not report brightness")
    current, maximum = map(int, fields[3:])
    if maximum <= 0 or not 0 <= current <= maximum:
        raise ValueError("Invalid monitor brightness")
    return round(100 * current / maximum), maximum

def status():
    state, monitors = load_state(), []
    for monitor_id, (name, _) in MONITORS.items():
        try:
            value, _ = read_brightness(monitor_id)
            if monitor_id in UNRELIABLE_READBACK:
                value = state.get(monitor_id, 60)
            state[monitor_id] = value
            monitors.append(dict(id=monitor_id, name=name, value=value, available=True,
                                 readback=monitor_id not in UNRELIABLE_READBACK))
        except (subprocess.SubprocessError, ValueError, OSError):
            monitors.append(dict(id=monitor_id, name=name, value=None, available=False))
    save_state(state)
    print(json.dumps(dict(monitors=monitors)))

def main():
    if sys.argv[1:] == ["--status"]:
        status()
        return
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <monitor_id> <+N|-N|N> | --status")
        sys.exit(1)

    monitor_id = sys.argv[1]
    change = sys.argv[2]

    state = load_state()
    if monitor_id not in MONITORS:
        sys.exit("Unknown monitor")
    current, maximum = read_brightness(monitor_id)
    if monitor_id in UNRELIABLE_READBACK:
        current = state.get(monitor_id, 60)

    if change.startswith(("+", "-")):
        try:
            delta = int(change)
        except ValueError:
            print("Invalid change format. Use +N, -N, or N.")
            sys.exit(1)
        new_val = current + delta
    else:
        try:
            new_val = int(change)
        except ValueError:
            print("Invalid value format. Use +N, -N, or N.")
            sys.exit(1)

    # Clamp to 0–100
    new_val = max(0, min(100, new_val))

    # Keep verification on displays that report their current setting correctly.
    options = ["--noverify"] if monitor_id in UNRELIABLE_READBACK else []
    ddc(monitor_id, "setvcp", VCP_CODE, str(round(new_val * maximum / 100)), *options)
    state[monitor_id] = new_val
    save_state(state)

    print(f"Monitor {monitor_id} brightness set to {new_val}%")

if __name__ == "__main__":
    with open(STATE_FILE + ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            main()
        except (subprocess.SubprocessError, ValueError, OSError) as error:
            sys.exit(f"Could not change monitor brightness: {error}")
