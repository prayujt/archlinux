#!/usr/bin/env python3
"""
Fetch NYT hard-news headlines (US Politics + Economy) for the quickshell news widget.

Outputs one JSON line: [{"title","desc","image","link"}, ...]

Uses NYT's public RSS section feeds (no API key needed). Opinion / features /
lifestyle sections are filtered out via the article URL so only straight news
headlines remain.
"""
import json
import urllib.request
import xml.etree.ElementTree as ET

FEEDS = [
    "https://rss.nytimes.com/services/xml/rss/nyt/Politics.xml",
    "https://rss.nytimes.com/services/xml/rss/nyt/Economy.xml",
]

# drop opinion / analysis / lifestyle / feature sections — keep news events only
BLOCK = (
    "/opinion/", "/insider/", "/cooking/", "/style/", "/t-magazine/", "/arts/",
    "/books/", "/movies/", "/theater/", "/travel/", "/realestate/", "/magazine/",
    "/well/", "/food/", "/dining/", "/fashion/", "/podcasts/", "/crosswords/",
    "/games/", "/wirecutter/", "/review/", "/interactive/", "/live/",
)

NS = {"media": "http://search.yahoo.com/mrss/"}


def main():
    items = []
    seen = set()
    for url in FEEDS:
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
            data = urllib.request.urlopen(req, timeout=10).read()
            root = ET.fromstring(data)
            for item in root.findall(".//item"):
                link = (item.findtext("link", "") or "").split("?")[0]
                if any(b in link for b in BLOCK):
                    continue
                title = item.findtext("title", "") or ""
                if link in seen:
                    continue
                seen.add(link)
                m = item.find("media:content", NS)
                items.append({
                    "title": title,
                    "desc": item.findtext("description", "") or "",
                    "image": m.get("url", "") if m is not None else "",
                    "link": link,
                })
        except Exception:
            pass
    print(json.dumps(items[:20]), flush=True)


main()
