#!/usr/bin/env python3
import sys
from soco import SoCo

SONOS_IP = '192.168.1.50'

speaker = SoCo(SONOS_IP)
cmd = sys.argv[1] if len(sys.argv) > 1 else ''

if cmd == 'toggle':
    state = speaker.get_current_transport_info()['current_transport_state']
    if state == 'PLAYING':
        speaker.pause()
    else:
        speaker.play()
elif cmd == 'play':
    speaker.play()
elif cmd == 'pause':
    speaker.pause()
elif cmd == 'next':
    speaker.next()
elif cmd == 'prev':
    speaker.previous()
elif cmd == 'vol-up':
    speaker.volume = min(100, speaker.volume + 2)
elif cmd == 'vol-down':
    speaker.volume = max(0, speaker.volume - 2)
elif cmd == 'mute':
    speaker.mute = not speaker.mute
