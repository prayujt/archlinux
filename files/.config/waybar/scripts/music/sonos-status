#!/usr/bin/env python3
import time
from soco import SoCo

SONOS_IP = '192.168.1.50'

speaker = SoCo(SONOS_IP)

while True:
    try:
        state = speaker.get_current_transport_info()['current_transport_state']
        if state == 'PLAYING':
            print('\uf04c', flush=True)  # pause icon
        else:
            print('\uf04b', flush=True)  # play icon
    except Exception:
        print('\uf04b', flush=True)
    time.sleep(1)
