[{
    "layer": "top",
    "output": "DP-3",
    "position": "top",
    "height": 30,
    "margin": "5 17 -8 17",
    "modules-left": ["custom/hyprland", "hyprland/window", "custom/caps"],
    "modules-center": ["custom/news"],
    "modules-right": ["custom/default-audio", "pulseaudio", "clock"],


    //***************************
    //*  Modules configuration  *
    //***************************

    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "rewrite": {
            "(.*) — Mozilla Firefox": " Mozilla Firefox",
            "(.*) - alacritty": "> [$1]",
            "": "No focused window"
        }
    },

    "clock": {
        "timezone": "America/New_York",
        "format": " {:%a, %d %b, %r}",
        "interval": 1
    },

    "pulseaudio": {
        "scroll-step": 1,
        "reverse-scrolling": 1,
        "format": "{icon}  {volume}%",
        "format-muted": " {volume}%",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "min-length": 10,
    },

    "tray": {
        "icon-size": 16,
        "spacing": 0
    },

    "custom/cava": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/audio/cava",
        "tooltip": "false"
    },

    "custom/caps": {
        "exec": "~/.config/waybar/scripts/caps/caps.sh",
        "tooltip": "false",
        "return-type": "json",
        "format": "{}",
    },

    "custom/news": {
        "format": "  {}",
        "exec": "news 75 0.06"
    },

    "custom/portfolio": {
        "format": " {}",
        "exec": "python ~/.config/waybar/scripts/stocks/stocks.py",
        "interval": 5,
        "on-click": "eww open --toggle stocks"
    },

    "custom/hyprland": {
        "format": "{}",
        "exec": "~/.cargo/bin/hyprland_events 1"
    },

    "custom/default-audio": {
      "format": "{}",
      "exec": "~/.config/waybar/scripts/audio/default-audio",
      "interval": 1,
      "tooltip": true,
      "on-click": "pavucontrol"
    },
},
{
    "layer": "top",
    "output": "HDMI-A-1",
    "position": "top",
    "height": 30,
    "margin": "5 17 -8 17",
    "modules-left": ["custom/hyprland"],
    "modules-center": ["custom/music-left", "custom/music", "custom/music-play-pause", "custom/music-right", "custom/sonos-volume"],

    "custom/hyprland": {
        "format": "{}",
        "exec": "~/.cargo/bin/hyprland_events 2"
    },

    "custom/music": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/music/sonos-title",
    },

    "custom/music-left": {
        "format": "",
        "on-click": "~/.config/waybar/scripts/music/sonos-ctl prev",
    },

    "custom/music-right": {
        "format": "",
        "on-click": "~/.config/waybar/scripts/music/sonos-ctl next",
    },

    "custom/music-play-pause": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/music/sonos-status",
        "on-click": "~/.config/waybar/scripts/music/sonos-ctl toggle",
    },


    "custom/sonos-volume": {
        "format": "{}",
        "exec": "~/.config/waybar/scripts/music/sonos-volume",
        "on-click": "~/.config/waybar/scripts/music/sonos-ctl mute",
        "on-scroll-up": "~/.config/waybar/scripts/music/sonos-ctl vol-up",
        "on-scroll-down": "~/.config/waybar/scripts/music/sonos-ctl vol-down",
    },
}]
