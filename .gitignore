# This repository lives in $HOME. Keep unrelated apps, projects, and personal files local.
/*
!/.bashrc
!/.config/
!/.emacs.d/
!/.gitignore
!/.icons/
!/.local/
!/.screenshots/
!/.scripts/
!/.zshrc
!/README.md
!/nix/

# Desktop style source; keep other local applications and runtime state private.
/.local/*
!/.local/bin/
!/.local/share/
/.local/bin/*
!/.local/bin/desktop-style
/.local/share/*
!/.local/share/desktop-styles/
/.local/share/desktop-styles/*
!/.local/share/desktop-styles/nothing-orbit/
!/.local/share/desktop-styles/original/
/.local/share/desktop-styles/nothing-orbit/*.png
/.local/share/desktop-styles/nothing-orbit/qmllint.txt
/.local/share/desktop-styles/nothing-orbit/references/
/.local/share/desktop-styles/nothing-orbit/revisions/

# Include desktop configuration source rather than application data.
/.config/*
!/.config/alacritty/
!/.config/bspwm/
!/.config/cava/
!/.config/chrome-flags.conf
!/.config/chromium-flags.conf
!/.config/eww/
!/.config/hypr/
!/.config/nix/
!/.config/nvim/
!/.config/quickshell/
!/.config/ranger/
!/.config/rofi/
!/.config/sddm/
!/.config/spaceship.zsh
!/.config/swaync/
!/.config/systemd/
!/.config/ticker/
!/.config/tickrs/
!/.config/waybar/
!/.config/wob/

/.emacs.d/*
!/.emacs.d/config/
!/.emacs.d/init.el
/.icons/*
!/.icons/default/
/.screenshots/*
!/.screenshots/screenshot.png
!/.screenshots/recording.mp4

# Only the audio switcher units belong to these desktop dotfiles.
/.config/systemd/*
!/.config/systemd/user/
/.config/systemd/user/*
!/.config/systemd/user/switch-audio.service
!/.config/systemd/user/switch-audio.timer

# Private credentials, runtime state, dependencies, and generated output.
.aider*
.env
.env.*
.secrets
.keys
.netrc
.authinfo
bitwarden-cli/
.venv/
.venv-tg/
__pycache__/
*.py[cod]
target/
*.before*
/.config/hypr/.brightness
/.config/waybar/scripts/news/news
/.config/quickshell/dashboard/checks/*.png
/.config/quickshell/dashboard/checks/previous-layout/
/.config/sddm/neon-dusk/checks/*.png
/.config/sddm/*-before-*/
