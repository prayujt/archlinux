#!/usr/bin/env python3
import sys
from soco import SoCo

SONOS_IP = '192.168.1.50'
speaker = SoCo(SONOS_IP)

d = sys.argv[1] if len(sys.argv) > 1 else ''
if d == 'up':
    speaker.volume = min(100, speaker.volume + 1)
elif d == 'down':
    speaker.volume = max(0, speaker.volume - 1)
elif d == 'mute':
    speaker.mute = not speaker.mute

# report new state to quickshell for OSD feedback (volume, or "mute" if muted)
try:
    val = 'mute' if speaker.mute else str(speaker.volume)
    with open('/tmp/qs-sonos-vol', 'w') as f:
        f.write(val + '\n')
except Exception:
    pass
