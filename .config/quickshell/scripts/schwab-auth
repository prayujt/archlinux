#!/usr/bin/env python3
"""
One-time Schwab OAuth helper. Run this in a terminal:

    python3 ~/.config/quickshell/scripts/schwab-auth

It prints an authorize URL -> log in and approve in the browser -> you'll be
redirected to your app's callback URL (it may show an error page, that's fine)
-> copy that FULL redirected URL from the address bar and paste it back here.

It exchanges the code for tokens and saves the refresh token to
~/.config/quickshell/.schwab_tokens.json so the widget can read your portfolio.

Nothing here places trades — it only obtains read credentials.
"""
import os
import sys
import json
import base64
import urllib.request
import urllib.parse

ENV_FILE = os.path.expanduser('~/.config/quickshell/.env')
TOKEN_FILE = os.path.expanduser('~/.config/quickshell/.schwab_tokens.json')


def load_env():
    d = {}
    with open(ENV_FILE) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith('#') or '=' not in line:
                continue
            k, v = line.split('=', 1)
            d[k.strip()] = v.strip().strip('"').strip("'")
    return d


def main():
    env = load_env()
    cid = env.get('CLIENT_ID')
    sec = env.get('CLIENT_SECRET')
    if not (cid and sec):
        print('CLIENT_ID / CLIENT_SECRET missing from', ENV_FILE)
        sys.exit(1)

    redirect = input('Callback URL registered on your Schwab app [https://127.0.0.1]: ').strip() or 'https://127.0.0.1'

    auth_url = 'https://api.schwabapi.com/v1/oauth/authorize?' + urllib.parse.urlencode({
        'client_id': cid,
        'redirect_uri': redirect,
    })
    print('\n1) Open this URL, log in, and approve:\n')
    print('   ' + auth_url + '\n')
    print('2) After approving you land on your callback URL (an error page is fine).')
    redirected = input('3) Paste the FULL redirected URL here:\n   ').strip()

    qs = urllib.parse.urlparse(redirected).query
    code = urllib.parse.parse_qs(qs).get('code', [None])[0]
    if not code:
        print('Could not find ?code= in that URL.')
        sys.exit(1)

    body = urllib.parse.urlencode({
        'grant_type': 'authorization_code',
        'code': code,
        'redirect_uri': redirect,
    }).encode()
    basic = base64.b64encode(f'{cid}:{sec}'.encode()).decode()
    req = urllib.request.Request(
        'https://api.schwabapi.com/v1/oauth/token',
        data=body,
        headers={
            'Authorization': f'Basic {basic}',
            'Content-Type': 'application/x-www-form-urlencoded',
        },
    )
    tok = json.load(urllib.request.urlopen(req, timeout=20))
    if 'refresh_token' not in tok:
        print('No refresh_token in response:', tok)
        sys.exit(1)

    with open(TOKEN_FILE, 'w') as f:
        json.dump({'refresh_token': tok['refresh_token']}, f)
    os.chmod(TOKEN_FILE, 0o600)
    print('\nSaved refresh token to', TOKEN_FILE)
    print('The portfolio widget will now show live data.')


main()
