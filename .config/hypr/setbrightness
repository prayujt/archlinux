#!/usr/bin/env python3
import sys
import os
import subprocess

STATE_FILE = os.path.join(os.path.dirname(os.path.abspath(__file__)), ".brightness")
VCP_CODE = "10"

def load_state():
    state = {}
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE, "r") as f:
            for line in f:
                try:
                    mon_id, val = line.strip().split(":")
                    state[mon_id] = int(val)
                except ValueError:
                    continue
    return state

def save_state(state):
    with open(STATE_FILE, "w") as f:
        for mon_id, val in state.items():
            f.write(f"{mon_id}:{val}\n")

def set_brightness(monitor_id, value):
    cmd = ["ddcutil", "-d", str(monitor_id), "setvcp", VCP_CODE, str(value)]
    subprocess.run(cmd, check=True)

def main():
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <monitor_id> <+N|-N|N>")
        sys.exit(1)

    monitor_id = sys.argv[1]
    change = sys.argv[2]

    state = load_state()
    current = state.get(monitor_id, 50)  # default to 50 if unknown

    if change.startswith(("+", "-")):
        try:
            delta = int(change)
        except ValueError:
            print("Invalid change format. Use +N, -N, or N.")
            sys.exit(1)
        new_val = current + delta
    else:
        try:
            new_val = int(change)
        except ValueError:
            print("Invalid value format. Use +N, -N, or N.")
            sys.exit(1)

    # Clamp to 0–100
    new_val = max(0, min(100, new_val))

    # Update state and write to file
    state[monitor_id] = new_val
    save_state(state)

    # Set brightness via ddcutil
    set_brightness(monitor_id, new_val)

    print(f"Monitor {monitor_id} brightness set to {new_val}%")

if __name__ == "__main__":
    main()
