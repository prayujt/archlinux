[Unit]
Description=Cache public news, photographs, and market quotes for the login screen
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=sddm
Group=sddm
ExecStart=/usr/local/libexec/sddm-news-fetch
CacheDirectory=sddm-news
CacheDirectoryMode=0755
UMask=0022
TimeoutStartSec=90
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
